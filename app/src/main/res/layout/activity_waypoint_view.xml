<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPlaceWaypoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wcv_tvPlaceWaypoint"
        android:textAlignment="center"
        android:textColor="#B6B6B6" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_below="@id/tvPlaceWaypoint" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvTitle"
        android:text="@string/wcv_tvTitle"
        android:layout_below="@id/tvPlaceWaypoint"
        android:textAlignment="textStart"/>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/rowTitle"
        android:layout_marginBottom="6dp"
        android:textColor="@color/error"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/tvTitle"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            />

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvDescription"
        android:text="@string/wcv_tvDescription"
        android:layout_below="@id/tvError"
        android:textAlignment="textStart"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDescription"
        android:id="@+id/etDescription"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btnApply"
        android:text="@string/wcv_btnApplyWaypoint"
        android:layout_below="@id/etDescription"/>

</RelativeLayout>